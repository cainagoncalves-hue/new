# Credenciais da API Elofy — escolha UMA das opções abaixo:

# Opção 1: Token estático (obtido via POST /login ou pelo navegador)
# Atenção: tokens de sessão expiram. Para jobs agendados, prefira a Opção 2.
# ELOFY_TOKEN=eyJ...

# Opção 2: Email + senha (recomendado para cron — autentica automaticamente)
ELOFY_EMAIL=seu_email@empresa.com
ELOFY_PASSWORD=sua_senha

ELOFY_BASE_URL=https://api.elofy.com.br

# Notificações (opcional) — URL de webhook para alertas de token expirado
# Compatível com Slack, Teams, Discord, n8n, Make, Zapier, etc.
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...

# Credenciais do Supabase (encontre em: Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
